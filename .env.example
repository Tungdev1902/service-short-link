# Environment Configuration
APP_ENV=development
APP_PORT=8080

# Domain Configuration
DOMAIN=short.sieuviet.com
BASE_URL=http://short.sieuviet.com

# Database Configuration
DATABASE_HOST=mariadb
DATABASE_PORT=3306
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_PORT=3306

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication
JWT_SECRET=
API_KEYS=

# Nginx Configuration - Fixed to port 80
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Observability Configuration (Optional Services)
OBSERVABILITY_ENABLED=true
METRICS_ENABLED=true

# Jaeger Configuration
JAEGER_ENABLED=true
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
JAEGER_UDP_5775=5775
JAEGER_UDP_6831=6831
JAEGER_UDP_6832=6832
JAEGER_HTTP_5778=5778
JAEGER_UI_PORT=16686
JAEGER_COLLECTOR_PORT=14268
JAEGER_GRPC_PORT=14250
JAEGER_ZIPKIN_PORT=9411

# Prometheus Configuration
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana Configuration
GRAFANA_ENABLED=true
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Performance Configuration
CACHE_TTL_LINKS=86400          # 24 hours in seconds
CACHE_TTL_QR=604800            # 7 days in seconds
SHORTCODE_LENGTH=7
SHORTCODE_MIN_LENGTH=5
SHORTCODE_MAX_LENGTH=10

DEFAULT_EXPIRY_DAYS=365